# このファイルは「キー名の見本」です。Gitに入れます。
#
# 使い方: このファイルを .env という名前でコピーし、値を書き込んでください。
#         .env は .gitignore 済みなのでGitには入りません。絶対にコミットしないでください。
#
#   Windows:  copy .env.example .env
#   Linux  :  cp .env.example .env

# DiscordのWebhook URL（オオイシさんが用意して共有）
DISCORD_WEBHOOK_URL=

# Flaskのセッション用の秘密鍵。各自が適当な長い文字列を入れる
SECRET_KEY=

# 自分の利用者ID。abe / oishi / okada / nakamura のどれか
MY_USER_ID=
